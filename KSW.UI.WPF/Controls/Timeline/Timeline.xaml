<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:KSW.UI.WPF.Converters"
                    xmlns:controls="clr-namespace:KSW.UI.WPF.Controls">

    <converters:ObjectConverter x:Key="ObjectConverter"></converters:ObjectConverter>
    <converters:IsLastItemConverter x:Key="IsLastItemConverter"></converters:IsLastItemConverter>
    <converters:TimelineFormatConverter x:Key="FormatConverter"></converters:TimelineFormatConverter>

    <Style TargetType="{x:Type controls:Timeline}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Timeline}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TimelineItem}">
        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Top"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimelineItem}">
                    <Grid 
                        x:Name="PART_RootGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="PART_IconAxisRoot"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                        x:Name="PART_Icon">
                                <ContentPresenter Margin="8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Icon}"
                                                  ContentTemplate="{TemplateBinding IconTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding IconTemplateSelector}"></ContentPresenter>
                                <Ellipse x:Name="PART_DefaultIcon"
                                         Width="12"
                                         Height="12"
                                         Margin="8"
                                         Visibility="{Binding Icon,RelativeSource={RelativeSource Mode=TemplatedParent},Converter={StaticResource ObjectConverter},ConverterParameter=True}"
                                         Fill="Gray"></Ellipse>
                            </Grid>
                            <Rectangle x:Name="PART_Rectangle"
                                       Grid.Row="1"
                                       Width="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Stretch"
                                       Fill="{DynamicResource KSW.Fill.Color2}">
                            </Rectangle>
                        </Grid>
                        <ContentPresenter x:Name="PART_Header"
                                          Grid.Row="0"
                                          Grid.Column="2"
                                          Margin="8,4"
                                          VerticalAlignment="Top"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          TextElement.FontSize="14"
                                          TextElement.Foreground="{DynamicResource KSW.Text.Color0}">
                        </ContentPresenter>
                        <ContentPresenter x:Name="PART_Content"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Margin="8,2"
                                          VerticalAlignment="Top"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.FontSize="12">
                        </ContentPresenter>
                        <TextBlock x:Name="PART_Time"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="8,2"
                                   VerticalAlignment="Top"
                                   FontSize="12"
                                   TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FormatConverter}">
                                    <Binding Path="Time" RelativeSource="{RelativeSource Mode=TemplatedParent}"></Binding>
                                    <Binding Path="TimeFormat" RelativeSource="{RelativeSource Mode=TemplatedParent}"></Binding>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource IsLastItemConverter}">
                                    <Binding RelativeSource="{RelativeSource Mode=FindAncestor,AncestorType={x:Type controls:Timeline}}" Path="ItemsSource"></Binding>
                                    <Binding></Binding>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="PART_Rectangle" Property="Fill" Value="Transparent"></Setter>
                        </DataTrigger>
                        <Trigger Property="Type" Value="Default">
                            <Setter TargetName="PART_DefaultIcon" Property="Fill" Value="{DynamicResource KSW.SemiGrey6}"></Setter>
                        </Trigger>
                        <Trigger Property="Type" Value="Error">
                            <Setter TargetName="PART_DefaultIcon" Property="Fill" Value="{DynamicResource KSW.SemiRed6}"></Setter>
                        </Trigger>
                        <Trigger Property="Type" Value="Ongoing">
                            <Setter TargetName="PART_DefaultIcon" Property="Fill" Value="{DynamicResource KSW.SemiBlue6}"></Setter>
                        </Trigger>
                        <Trigger Property="Type" Value="Success">
                            <Setter TargetName="PART_DefaultIcon" Property="Fill" Value="{DynamicResource KSW.SemiGreen6}"></Setter>
                        </Trigger>
                        <Trigger Property="Type" Value="Warning">
                            <Setter TargetName="PART_DefaultIcon" Property="Fill" Value="{DynamicResource KSW.SemiOrange6}"></Setter>
                        </Trigger>
                        <Trigger Property="Position" Value="Left">
                            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                            <Setter TargetName="PART_Header" Property="Grid.Row" Value="0"></Setter>
                            <Setter TargetName="PART_Header" Property="Grid.Column" Value="2"></Setter>
                            <Setter TargetName="PART_Content" Property="Grid.Row" Value="1"></Setter>
                            <Setter TargetName="PART_Content" Property="Grid.Column" Value="2"></Setter>
                            <Setter TargetName="PART_Time" Property="Grid.Row" Value="2"></Setter>
                            <Setter TargetName="PART_Time" Property="Grid.Column" Value="2"></Setter>
                            <Setter TargetName="PART_Time" Property="TextAlignment" Value="Left"></Setter>
                            <Setter TargetName="PART_Time" Property="HorizontalAlignment" Value="Left"></Setter>
                            <Setter TargetName="PART_Time" Property="Margin" Value="8,2,8,12"></Setter>
                        </Trigger>

                        <Trigger Property="Position" Value="Right">
                            <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Right"></Setter>
                            <Setter TargetName="PART_Header" Property="Grid.Row" Value="0"></Setter>
                            <Setter TargetName="PART_Header" Property="Grid.Column" Value="0"></Setter>
                            <Setter TargetName="PART_Content" Property="Grid.Row" Value="1"></Setter>
                            <Setter TargetName="PART_Content" Property="Grid.Column" Value="0"></Setter>
                            <Setter TargetName="PART_Time" Property="Grid.Row" Value="2"></Setter>
                            <Setter TargetName="PART_Time" Property="Grid.Column" Value="0"></Setter>
                            <Setter TargetName="PART_Time" Property="TextAlignment" Value="Right"></Setter>
                            <Setter TargetName="PART_Time" Property="HorizontalAlignment" Value="Right"></Setter>
                            <Setter TargetName="PART_Time" Property="Margin" Value="8,2,8,12"></Setter>
                        </Trigger>

                        <Trigger Property="Position" Value="Separate">
                            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                            <Setter TargetName="PART_Header" Property="Grid.Row" Value="0"></Setter>
                            <Setter TargetName="PART_Header" Property="Grid.Column" Value="2"></Setter>

                            <Setter TargetName="PART_Content" Property="Grid.Row" Value="1"></Setter>
                            <Setter TargetName="PART_Content" Property="Grid.Column" Value="2"></Setter>
                            <Setter TargetName="PART_Content" Property="Margin" Value="8,2,8,12"></Setter>

                            <Setter TargetName="PART_Time" Property="Grid.Row" Value="0"></Setter>
                            <Setter TargetName="PART_Time" Property="Grid.Column" Value="0"></Setter>
                            <Setter TargetName="PART_Time" Property="TextAlignment" Value="Right"></Setter>
                            <Setter TargetName="PART_Time" Property="HorizontalAlignment" Value="Right"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>