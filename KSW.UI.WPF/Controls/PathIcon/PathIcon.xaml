<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:KSW.UI.WPF.Controls">
    <Style TargetType="{x:Type controls:PathIcon}">
        <Setter Property="Width" Value="{DynamicResource KSW.Icon.Width.Medium}"></Setter>
        <Setter Property="Height" Value="{DynamicResource KSW.Icon.Width.Medium}"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PathIcon}">
                    <Border Background="{TemplateBinding Background}">
                        <Viewbox 
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                            <Path
                                x:Name="PART_Path"
                                Width="24"
                                Height="24"
                                Data="{TemplateBinding Data}"
                                Fill="{TemplateBinding Foreground}">
                            </Path>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>