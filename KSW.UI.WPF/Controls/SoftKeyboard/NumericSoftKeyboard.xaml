<UserControl x:Class="KSW.UI.WPF.Controls.NumericSoftKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KSW.UI.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="554" d:DesignWidth="340"
             d:DataContext="{d:DesignInstance local:NumericSoftKeyboard}"
             Width="340"
             Height="554"
             Focusable="False"
             >
    <UserControl.Resources>
        <Style x:Key="KeyboardButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"></Setter>
            <Setter Property="Width" Value="80"></Setter>
            <Setter Property="Height" Value="80"></Setter>
            <Setter Property="Focusable" Value="False"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource KSW.Border.Background}">
        <Grid Margin="4,8,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock 
                Text="{Binding Title}" 
                Foreground="{DynamicResource KSW.Brush.Foreground}"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"></TextBlock>

            <TextBox Grid.Row="1"
                     x:Name="ValueDisplayTextBox"
                     Height="70"
                     BorderThickness="1"
                     Margin="0,8"
                     HorizontalContentAlignment="Right"
                     VerticalContentAlignment="Bottom"
                     Focusable="False"
                     FontSize="20"
                     Text="{Binding DisplayValue,UpdateSourceTrigger=PropertyChanged}"></TextBox>

            <Grid Grid.Row="2" Height="420">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <WrapPanel Orientation="Vertical" Grid.RowSpan="2">
                    <Button Margin="0,0,0,4" Content="7" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="7"></Button>
                    <Button Margin="0,0,0,4" Command="{Binding ClickComamd}" CommandParameter="4" Content="4" Style="{StaticResource KeyboardButtonStyle}"></Button>
                    <Button Margin="0,0,0,4" Command="{Binding ClickComamd}" CommandParameter="1" Content="1" Style="{StaticResource KeyboardButtonStyle}"></Button>
                    <Button Margin="0,0,0,4" Command="{Binding ClickComamd}" CommandParameter="0" Content="0" Style="{StaticResource KeyboardButtonStyle}"></Button>
                    <Button Content="Esc" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding CancelCommand}" Focusable="False"></Button>
                </WrapPanel>
                
                <WrapPanel Grid.Column="2" Orientation="Vertical" Grid.RowSpan="2">
                    <Button Margin="0,0,0,4" Content="8" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="8"></Button>
                    <Button Margin="0,0,0,4" Content="5" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="5"></Button>
                    <Button Margin="0,0,0,4" Content="2" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="2"></Button>
                    <Button Margin="0,0,0,4" Content="." Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="."/>
                    <Button Content="←" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="Back"></Button>
                </WrapPanel>

                <WrapPanel Grid.Column="4" Orientation="Vertical" Grid.RowSpan="2">
                    <Button Margin="0,0,0,4"  Content="9" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="9"></Button>
                    <Button Margin="0,0,0,4"  Content="6" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="6"></Button>
                    <Button Margin="0,0,0,4"  Content="3" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="3"></Button>
                    <Button Margin="0,0,0,4"  Content="±" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding ClickComamd}" CommandParameter="Negate"/>
                    <Button Content="▼" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding DownKeyCommand}"></Button>
                </WrapPanel>

                <WrapPanel x:Name="MultiplePanel" Grid.Column="6" Orientation="Vertical" Grid.RowSpan="2">
                    <Button x:Name="Btn_Unit4" Margin="0,0,0,4" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding SureCommand}" CommandParameter="3"></Button>
                    <Button x:Name="Btn_Unit3" Margin="0,0,0,4" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding SureCommand}" CommandParameter="2"></Button>
                    <Button x:Name="Btn_Unit2" Margin="0,0,0,4" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding SureCommand}" CommandParameter="1"></Button>
                    <Button x:Name="Btn_Unit1" Margin="0,0,0,4" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding SureCommand}" CommandParameter="0"/>
                    <Button Content="▲" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding UpKeyCommand}"></Button>
                </WrapPanel>

                <WrapPanel Visibility="Collapsed" x:Name="SinglePanel" Grid.Column="6" Orientation="Vertical" Grid.RowSpan="2">
                    <Button x:Name="Btn_Unit" Margin="0,0,0,4" Height="332" Content="8" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding SureCommand}" CommandParameter="0"></Button>
                    <Button Content="▲" Style="{StaticResource KeyboardButtonStyle}" Command="{Binding UpKeyCommand}" CommandParameter="Up"></Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
