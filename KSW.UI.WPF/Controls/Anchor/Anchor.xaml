<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:KSW.UI.WPF.Controls"
                    xmlns:converters="clr-namespace:KSW.UI.WPF.Converters">

    <converters:TreeLevelToPaddingConverter x:Key="TreeLevelToPaddingConverter"></converters:TreeLevelToPaddingConverter>

    <Style TargetType="{x:Type controls:Anchor}">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="VerticalAlignment" Value="Top"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Anchor}">
                    <Grid>
                        <Rectangle x:Name="PART_Pipe"
                                   Width="2"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"
                                   Fill="{DynamicResource KSW.Border.Color}">

                        </Rectangle>
                        <ItemsPresenter x:Name="PART_ItemsPresenter" 
                                        Margin="{TemplateBinding Padding}"></ItemsPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Mode" Value="Muted">
                            <Setter TargetName="PART_Pipe" Property="Fill" Value="Transparent"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AnchorItem}">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AnchorItem}">
                    <StackPanel>
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Pipe"
                                    Width="2"
                                    Tag="{DynamicResource KSW.Anchor.Indent}"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    >
                            </Border>
                            <Border>
                                <Border.Padding>
                                    <MultiBinding Converter="{StaticResource TreeLevelToPaddingConverter}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"></Binding>
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Mode=Self}"></Binding>
                                    </MultiBinding>
                                </Border.Padding>
                                <ContentPresenter x:Name="PART_HeaderPresenter"
                                                  MinHeight="20"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="{DynamicResource KSW.Text.Color2}"
                                                Content="{TemplateBinding Header}"
                                                ContentTemplate="{TemplateBinding HeaderTemplate}">
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ItemsPresenter></ItemsPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="DisplayMode" Value="Small">
                            <Setter TargetName="PART_HeaderPresenter" Property="MinHeight" Value="16"></Setter>
                            <Setter TargetName="PART_HeaderPresenter" Property="TextElement.FontSize" Value="12"></Setter>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource KSW.Text.Color0}" ></Setter>
                            <Setter TargetName="PART_Pipe" Property="Background" Value="{DynamicResource KSW.Primary.Color}"></Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DisplayMode" Value="Tertiary" ></Condition>
                                <Condition Property="IsSelected" Value="True"></Condition>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource KSW.SemiGrey5}"></Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DisplayMode" Value="Muted" ></Condition>
                                <Condition Property="IsSelected" Value="True"></Condition>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent"></Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>