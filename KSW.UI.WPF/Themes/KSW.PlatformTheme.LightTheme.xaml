<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="KSW.Toast.Brush.Information" Color="#0064fa"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Brush.Success" Color="#3bb346"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Brush.Warning" Color="#fc8800"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Brush.Error" Color="#f93920"></SolidColorBrush>

    <SolidColorBrush x:Key="KSW.Toast.Background.Information" Color="#eaf5ff"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Background.Success" Color="#ecf7ec"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Background.Warning" Color="#fff8ea"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Background.Error" Color="#fef2ed"></SolidColorBrush>

    <SolidColorBrush x:Key="KSW.Border.Background" Color="#ffffff"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Button.Foreground.Cancel" Color="#474A4D"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Button.Background.Cancel" Color="#F5F5F6"></SolidColorBrush>
</ResourceDictionary>