<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="KSW.Toast.Brush.Information" Color="#54a9ff"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Brush.Success" Color="#5dc264"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Brush.Warning" Color="#ffae43"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Brush.Error" Color="#fc725a"></SolidColorBrush>

    <SolidColorBrush x:Key="KSW.Toast.Background.Information" Color="#233448"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Background.Success" Color="#253929"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Background.Warning" Color="#453522"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Toast.Background.Error" Color="#442927"></SolidColorBrush>

    <SolidColorBrush x:Key="KSW.Border.Background" Color="#43444a"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Button.Foreground.Cancel" Color="#D9D9DA"></SolidColorBrush>
    <SolidColorBrush x:Key="KSW.Button.Background.Cancel" Color="#595A5F"></SolidColorBrush>
</ResourceDictionary>